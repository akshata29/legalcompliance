# ════════════════════════════════════════════════════════════════
# Legal Compliance App — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control.
# ════════════════════════════════════════════════════════════════

# ── Entra ID (Azure AD) — used for CosmosDB + Blob Storage auth ──────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-service-principal-client-id>
AZURE_CLIENT_SECRET=<your-service-principal-secret>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT_NAME=chat4o
FOUNDRY_AGENT_NAME=legalcompliance
FOUNDRY_API_VERSION=2025-05-15-preview
FOUNDRY_RESPONSE_TIMEOUT_SECONDS=180

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=chat4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=embedding

# ── Azure AI Search ───────────────────────────────────────────────────────────
SEARCH_ENDPOINT=https://<search-resource>.search.windows.net
SEARCH_INDEX=legalcompliance
SEARCH_API_KEY_SECRET_NAME=<your-search-admin-key>

# ── Azure Document Intelligence ───────────────────────────────────────────────
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<docintel-resource>.cognitiveservices.azure.com
DOCUMENT_INTELLIGENCE_API_KEY=<your-document-intelligence-key>

# ── Azure Content Understanding (optional — falls back to Document Intelligence)
CONTENT_UNDERSTANDING_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
CONTENT_UNDERSTANDING_API_VERSION=2025-11-01
CONTENT_UNDERSTANDING_API_KEY=
CONTENT_UNDERSTANDING_COMPLETION_MODEL=gpt-4.1

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Connection string is kept for reference; runtime auth uses Azure AD via AZURE_CLIENT_ID/SECRET.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
AZURE_BLOB_STORAGE_NAME=<storage-account-name>
AZURE_STORAGE_CONTAINER=portfolio

# ── Azure Cosmos DB ───────────────────────────────────────────────────────────
# No API key required — auth uses Azure AD service principal above.
COSMOSDB_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DB_DATABASE=compexdocs
COSMOS_DB_CONTAINER=legal

# ── Bing Grounding (optional) ─────────────────────────────────────────────────
BING_GROUNDING_CONNECTION_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<foundry>/projects/<project>/connections/<bing-connection>
BING_GROUNDING_CONNECTION_NAME=<bing-connection-name>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Pipeline tuning (optional — these are the defaults) ──────────────────────
# LEGACY_MAX_WORKERS=5
# OPTIMIZED_BATCH_SIZE=10
# OPTIMIZED_SEMAPHORE_LIMIT=5
